  "selectable_choice": {
    "scope": "empires-story,plaintext",
    "prefix": "emp-selectable_choice",
    "body": [
      "#${1:Choice} -> ${2:destination} [selectable_if ${3:gold} >= ${4:10}]"
    ],
    "description": "Empires selectable_choice"
  },
  "compound_condition": {
    "scope": "empires-story,plaintext",
    "prefix": "emp-compound_condition",
    "body": [
      "*if (${1:ready}) and not (${2:blocked})",
      "  ${3:Text}"
    ],
    "description": "Empires compound_condition"
  }
