{
  "var": {
    "scope": "plaintext",
    "prefix": "emp-var",
    "body": [
      "*var ${1:name} ${2:0}"
    ],
    "description": "Empires var"
  },
  "stat": {
    "scope": "plaintext",
    "prefix": "emp-stat",
    "body": [
      "*stat ${1:name} \"${2:Label}\""
    ],
    "description": "Empires stat"
  },
  "skill": {
    "scope": "plaintext",
    "prefix": "emp-skill",
    "body": [
      "*skill ${1:skill_id} \"${2:Skill name}\""
    ],
    "description": "Empires skill"
  },
  "item": {
    "scope": "plaintext",
    "prefix": "emp-item",
    "body": [
      "*item ${1:item_id} \"${2:Item name}\""
    ],
    "description": "Empires item"
  },
  "chapter": {
    "scope": "plaintext",
    "prefix": "emp-chapter",
    "body": [
      "*chapter ${1:Chapter name}"
    ],
    "description": "Empires chapter"
  },
  "passage": {
    "scope": "plaintext",
    "prefix": "emp-passage",
    "body": [
      "*passage ${1:passage_id}",
      "*title ${2:Title}",
      "",
      "${3:Narrative.}",
      "",
      "$0"
    ],
    "description": "Empires passage"
  },
  "choice": {
    "scope": "plaintext",
    "prefix": "emp-choice",
    "body": [
      "*choice",
      "  #${1:Choice label} -> ${2:destination}",
      "$0"
    ],
    "description": "Empires choice"
  },
  "conditional-choice": {
    "scope": "plaintext",
    "prefix": "emp-conditional-choice",
    "body": [
      "*choice",
      "  #${1:Conditional choice} -> ${2:destination} [if ${3:variable} >= ${4:1}]",
      "  #${5:Fallback} -> ${6:destination}",
      "$0"
    ],
    "description": "Empires conditional-choice"
  },
  "show-if": {
    "scope": "plaintext",
    "prefix": "emp-show-if",
    "body": [
      "*show_if ${1:variable} == ${2:true}",
      "${3:Conditional paragraph.}",
      "",
      "$0"
    ],
    "description": "Empires show-if"
  },
  "continue": {
    "scope": "plaintext",
    "prefix": "emp-continue",
    "body": [
      "*continue ${1:destination}"
    ],
    "description": "Empires continue"
  },
  "input-text": {
    "scope": "plaintext",
    "prefix": "emp-input-text",
    "body": [
      "*input_text ${1:variable} \"${2:Label}\" -> ${3:destination}"
    ],
    "description": "Empires input-text"
  },
  "checkpoint": {
    "scope": "plaintext",
    "prefix": "emp-checkpoint",
    "body": [
      "*checkpoint"
    ],
    "description": "Empires checkpoint"
  },
  "journal": {
    "scope": "plaintext",
    "prefix": "emp-journal",
    "body": [
      "*journal ${1:event_id} \"${2:Recorded text}\""
    ],
    "description": "Empires journal"
  },
  "set": {
    "scope": "plaintext",
    "prefix": "emp-set",
    "body": [
      "*set ${1:variable} ${2:0}"
    ],
    "description": "Empires set"
  },
  "add": {
    "scope": "plaintext",
    "prefix": "emp-add",
    "body": [
      "*add ${1:variable} ${2:1}"
    ],
    "description": "Empires add"
  },
  "grant-skill": {
    "scope": "plaintext",
    "prefix": "emp-grant-skill",
    "body": [
      "*grant_skill ${1:skill_id}"
    ],
    "description": "Empires grant-skill"
  },
  "revoke-skill": {
    "scope": "plaintext",
    "prefix": "emp-revoke-skill",
    "body": [
      "*revoke_skill ${1:skill_id}"
    ],
    "description": "Empires revoke-skill"
  },
  "add-item": {
    "scope": "plaintext",
    "prefix": "emp-add-item",
    "body": [
      "*add_item ${1:item_id} ${2:1}"
    ],
    "description": "Empires add-item"
  },
  "remove-item": {
    "scope": "plaintext",
    "prefix": "emp-remove-item",
    "body": [
      "*remove_item ${1:item_id} ${2:1}"
    ],
    "description": "Empires remove-item"
  },
  "death": {
    "scope": "plaintext",
    "prefix": "emp-death",
    "body": [
      "*death"
    ],
    "description": "Empires death"
  }
}
